# Движок Deepgram (облако). Необязательно, если используете только WhisperX.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Токен Hugging Face. НЕОБЯЗАТЕЛЕН: приложение работает без него. Нужен только для экспериментального
# разбора по голосам после записи (transcribe_file.py --diarization post). См. README, шаг 5.
HF_TOKEN=

# Необязательные настройки WhisperX (по умолчанию выбираются автоматически):
# WHISPER_MODEL=large-v3-turbo      # small | medium | large-v3-turbo | large-v3
# WHISPER_DEVICE=auto               # auto | cuda | cpu
# WHISPER_COMPUTE_TYPE=float16      # float16 (GPU) | int8 (CPU)
# WHISPER_USE_CONTEXT=1             # экспериментально: подсказывать Whisper конец прошлой фразы.
#                                   # На тестовых записях не дало стабильного выигрыша, по умолчанию выключено.
